# ==============================================================================
# Mehedi Portfolio - Frontend Environment Variables (.env.example)
# Copy this file to .env.local for local development.
# ==============================================================================

# Base URL for the public web application
# Required for absolute metadata canonical URLs, hreflang links, and Open Graph tags.
# Local development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Base URL for the Express Backend REST API
# Points to backend server endpoints for contact messages, dynamic data, and CMS.
# Local development: http://localhost:5000/api
# Production: https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# Default locale for bilingual support ('en' or 'bn')
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# Site brand name for SEO and header titles
NEXT_PUBLIC_SITE_NAME="Mehedi Hasan — Senior Full-Stack Architect"
