# ==============================================================================
# Mehedi Portfolio - Frontend Environment Variables (.env.example)
# Location: .env.local (FRONTEND CLIENT & SERVER RUNTIME, NEVER COMMIT REAL SECRETS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC APPLICATION URL
# ------------------------------------------------------------------------------
# Base canonical URL for the frontend Next.js web application
# Where to obtain: Your domain (e.g. https://mehedi.dev) or localhost
# Required: Yes (used for canonical URLs, hreflang alternates, Open Graph meta)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. BACKEND API URL
# ------------------------------------------------------------------------------
# Absolute URL pointing to the Express REST API /api prefix
# Where to obtain: Your backend deployment URL (e.g., https://api.mehedi.dev/api) or local API
# Required: Yes (used by typed API client for messages, admin login, settings, and dynamic data)
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# ------------------------------------------------------------------------------
# 3. LOCALIZATION & BRANDING
# ------------------------------------------------------------------------------
# Default fallback locale for bilingual routing ('en' or 'bn')
# Required: No (defaults to 'en')
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# Site brand title for SEO metadata and navigation headers
# Required: No
NEXT_PUBLIC_SITE_NAME="Mehedi Hasan — Senior Full-Stack Architect"
