# ==============================================================================
# Mehedi Portfolio - Backend Environment Variables (.env.example)
# Copy this file to backend/.env for local backend development.
# ==============================================================================

# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Obtain from MongoDB Atlas cluster -> Connect -> Drivers (Node.js)
# Example: mongodb+srv://<username>:<password>@cluster.example.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/mehedi_portfolio"

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list or single origin allowed to make browser requests
CORS_ORIGIN="http://localhost:3000"

# Authentication & JWT Configuration (Phase 2)
# Generate a secure 64+ char random string: openssl rand -base64 48
JWT_SECRET="replace_with_a_secure_jwt_secret_token_in_production"
JWT_EXPIRES_IN="7d"

# Remote Media Storage - Cloudinary (Phase 2+)
# Obtain from Cloudinary Dashboard -> API Keys
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

