# ==============================================================================
# Mehedi Portfolio - Backend Environment Variables (.env.example)
# Location: backend/.env (SERVER-ONLY, NEVER COMMIT TO GIT)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Port the Express REST API listens on
# Where to obtain: Any open port on your host (e.g. 5000 locally, standard assigned port on Render/Railway)
# Required: No (defaults to 5000)
PORT=5000

# Node.js runtime environment: 'development' | 'production' | 'test'
# Where to obtain: Set to 'production' on your production server; 'development' locally
# Required: No (defaults to 'development')
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Connection string for MongoDB Atlas or local MongoDB instance
# Where to obtain:
#   1. Sign in to MongoDB Atlas (https://cloud.mongodb.com)
#   2. Choose your Cluster -> Click "Connect" -> Choose "Drivers" (Node.js)
#   3. Copy URI and replace <password> with your database user password
# Required: Yes (Required for persistent database storage; serves fallback mock data if offline)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/mehedi_portfolio?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 3. CORS ORIGIN (Frontend URL)
# ------------------------------------------------------------------------------
# Allowed origin(s) permitted to make browser requests to this API
# Where to obtain: Your frontend deployment URL (e.g., https://yourdomain.com) or localhost
# Multiple origins can be comma-separated: "http://localhost:3000,https://mehedi.dev"
# Required: Yes in production
CORS_ORIGIN="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SESSION CONFIGURATION (JWT & Session Cookies)
# ------------------------------------------------------------------------------
# Secret encryption key used to sign and verify owner authentication JWT tokens
# Where to obtain: Generate a cryptographically secure 64-character random string:
#   Command: openssl rand -base64 48
# Required: Yes in production (must be at least 32 characters)
JWT_SECRET="replace_with_a_secure_jwt_secret_token_at_least_32_chars_in_production"

# Lifespan duration for JWT session tokens (e.g. "7d", "24h", "30d")
# Required: No (defaults to "7d")
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 5. INITIAL OWNER ACCOUNT AUTO-SEEDING (Optional / One-Time)
# ------------------------------------------------------------------------------
# If set AND the database has 0 users, the server automatically seeds the initial
# owner account upon startup with role='owner'. Afterwards, these can be removed.
# Required: No (alternatively, initialize via POST /api/auth/setup-initial-admin)
ADMIN_INITIAL_EMAIL="admin@mehedi.dev"
ADMIN_INITIAL_PASSWORD="ChangeMe_SecurePassword_2026!"

# ------------------------------------------------------------------------------
# 6. REMOTE MEDIA STORAGE - CLOUDINARY (Optional / Phase 2+)
# ------------------------------------------------------------------------------
# Cloudinary credentials for hosting screenshot and media assets
# Where to obtain: Cloudinary Dashboard (https://cloudinary.com/console) -> Dashboard -> API Keys
# Required: No (optional for dynamic media uploads; local fallback paths work out of the box)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
